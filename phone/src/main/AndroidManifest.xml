<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Agenda Peek from the phone's calendars, when no Sable Calendar answers. Asked for on the Agenda screen. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Open-Meteo weather for the city the user picks. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- WorkManager adds this for foreground work, which the companion never does. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />

    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@drawable/ic_sable"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Opened from the watch when a Sable bubble is tapped (sablewatch://open/<target>). -->
        <activity
            android:name=".open.OpenFromWatchActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="open"
                    android:scheme="sablewatch" />
            </intent-filter>
        </activity>

        <!-- Refresh from the watch: a Data Layer message that asks for a sync now. -->
        <service
            android:name=".sync.RefreshListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:path="/sablewatch/refresh"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- Optional: counts notifications and triggers a sync. No text is read or kept. -->
        <service
            android:name=".sync.UnreadListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
