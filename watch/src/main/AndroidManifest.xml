<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Open-Meteo for the phone's weather city, only while the phone has been away an hour. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@drawable/ic_sable"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Works without the phone: the world clock is computed on the watch, and the other
             sources keep the last state the phone sent. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <service
            android:name=".complications.WorldClockDataSource"
            android:exported="true"
            android:icon="@drawable/ic_world"
            android:label="@string/world_clock_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="LONG_TEXT,SHORT_TEXT" />
            <!-- The data carries a minute-by-minute timeline for the next hour, so it only
                 needs a refresh every 30 minutes. -->
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="1800" />
            <!-- The Sable face may use this source as its default without asking (see watchface.xml). -->
            <meta-data
                android:name="android.support.wearable.complications.SAFE_WATCH_FACES"
                android:value="io.github.aimindseye.sablewatch.face" />
        </service>
        <service
            android:name=".complications.AgendaPeekDataSource"
            android:exported="true"
            android:icon="@drawable/ic_sable"
            android:label="@string/agenda_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="LONG_TEXT,SHORT_TEXT" />
            <!-- Pushed by the phone (StateListenerService); no polling. -->
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
            <!-- The Sable face may use this source as its default without asking (see watchface.xml). -->
            <meta-data
                android:name="android.support.wearable.complications.SAFE_WATCH_FACES"
                android:value="io.github.aimindseye.sablewatch.face" />
        </service>

        <service
            android:name=".complications.MessagesDataSource"
            android:exported="true"
            android:icon="@drawable/ic_hub"
            android:label="@string/messages_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT" />
            <!-- Pushed by the phone (StateListenerService); no polling. -->
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
            <!-- The Sable face may use this source as its default without asking (see watchface.xml). -->
            <meta-data
                android:name="android.support.wearable.complications.SAFE_WATCH_FACES"
                android:value="io.github.aimindseye.sablewatch.face" />
        </service>

        <service
            android:name=".complications.WeatherDataSource"
            android:exported="true"
            android:icon="@drawable/ic_weather"
            android:label="@string/weather_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT" />
            <!-- Pushed by the phone; polled every 30 minutes only to fetch weather on the watch
                 when the phone has been away for over an hour. -->
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="1800" />
            <!-- The Sable face may use this source as its default without asking (see watchface.xml). -->
            <meta-data
                android:name="android.support.wearable.complications.SAFE_WATCH_FACES"
                android:value="io.github.aimindseye.sablewatch.face" />
        </service>

        <!-- The Hub list on the watch, opened from the Hub bubble. -->
        <activity
            android:name=".hub.HubActivity"
            android:exported="true"
            android:label="@string/hub_app_label"
            android:taskAffinity="">
            <!-- Also in the watch's app list, to refresh from the phone or read the Hub. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- A tapped Sable bubble: asks the phone to open the matching screen, then closes. -->
        <activity
            android:name=".open.OpenOnPhoneActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="" />

        <!-- The phone's state over the Wear OS Data Layer. -->
        <service
            android:name=".sync.StateListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/sablewatch"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>
</manifest>
